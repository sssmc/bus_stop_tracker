# Install to /etc/systemd/system/bus-stop-tracker.service
#
#   sudo cp deploy/bus-stop-tracker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bus-stop-tracker
#
# Adjust User / WorkingDirectory / ExecStart if you didn't use the paths in
# DEPLOYMENT.md. See that file for the port 443 vs 3000 trade-off.

[Unit]
Description=Bus Stop Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bst
WorkingDirectory=/opt/bus_stop_tracker
Environment=PORT=443
ExecStart=/usr/bin/node server/server.js
Restart=always
RestartSec=3

# Let the unprivileged user bind port 443. Drop this line if PORT >= 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# The app only ever writes inside its own directory (data.sqlite, Data/, certs/).
ProtectSystem=strict
ReadWritePaths=/opt/bus_stop_tracker
PrivateTmp=true

[Install]
WantedBy=multi-user.target
